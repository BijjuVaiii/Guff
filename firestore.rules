rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check if the authenticated user's email is whitelisted
    function isWhitelisted() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower()));
    }

    // Whitelist rules: only whitelisted users can read (to verify if they can log in)
    match /whitelist/{email} {
      allow read: if isAuthenticated() && request.auth.token.email.lower() == email.lower();
      allow write: if false; // Only manageable via Firebase Console or Admin
    }

    // User profiles rules
    match /users/{userId} {
      allow read: if isWhitelisted();
      allow write: if isWhitelisted() && request.auth.uid == userId;
    }

    // Rooms rules
    match /rooms/{roomId} {
      allow read: if isWhitelisted();
      allow create: if isWhitelisted();
      allow update, delete: if isWhitelisted() && (roomId == 'group-chat' || request.auth.uid in resource.data.members);
      
      // Messages subcollection rules
      match /messages/{messageId} {
        allow read, write: if isWhitelisted();
      }
      
      // Typing subcollection rules
      match /typing/{userId} {
        allow read: if isWhitelisted();
        allow write: if isWhitelisted() && request.auth.uid == userId;
      }
    }
  }
}
